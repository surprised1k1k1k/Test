		function TabMethods:CreateDropdown(text, options, defaultKey, nameMap, flagName, callback)
			nameMap = nameMap or {}
			local DropdownFrame = Instance.new("Frame")
			DropdownFrame.Size = UDim2.new(1, -10, 0, 45)
			DropdownFrame.BackgroundColor3 = Color3.fromRGB(85, 50, 32)
			DropdownFrame.ClipsDescendants = true
			DropdownFrame.Parent = ScrollFrame

			local Label = Instance.new("TextLabel")
			Label.Size = UDim2.new(0.4, 0, 0, 45)
			Label.Position = UDim2.new(0, 12, 0, 0)
			Label.Text = text
			Label.TextColor3 = Color3.fromRGB(255, 252, 245)
			Label.Font = Enum.Font.SourceSans
			Label.TextSize = 14
			Label.TextXAlignment = Enum.TextXAlignment.Left
			Label.BackgroundTransparency = 1
			Label.Parent = DropdownFrame

			local selectedKey = defaultKey or options[1]
			local selectedDisplay = nameMap[selectedKey] or selectedKey

			local MainBtn = Instance.new("TextButton")
			MainBtn.Size = UDim2.new(0.5, 0, 0, 30)
			MainBtn.Position = UDim2.new(0.45, 0, 0, 7.5)
			MainBtn.BackgroundColor3 = Color3.fromRGB(50, 28, 16)
			MainBtn.Text = selectedDisplay .. " ▼"
			MainBtn.TextColor3 = Color3.fromRGB(255, 220, 180)
			MainBtn.Font = Enum.Font.SourceSansBold
			MainBtn.TextSize = 14
			MainBtn.Parent = DropdownFrame

			local Container = Instance.new("ScrollingFrame")
			Container.Size = UDim2.new(0.5, 0, 0, 0)
			Container.Position = UDim2.new(0.45, 0, 0, 40)
			Container.BackgroundColor3 = Color3.fromRGB(40, 20, 10)
			Container.BorderSizePixel = 0
			Container.ScrollBarThickness = 4
			Container.Parent = DropdownFrame

			local OptionLayout = Instance.new("UIListLayout")
			OptionLayout.Parent = Container
			OptionLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
				Container.CanvasSize = UDim2.new(0, 0, 0, OptionLayout.AbsoluteContentSize.Y)
			end)

			local isOpen = false
			local function toggleDropdown()
				isOpen = not isOpen
				if isOpen then
					local maxDisplayHeight = 150
					local calculatedHeight = math.min(#options * 25, maxDisplayHeight)
					Container.Size = UDim2.new(0.5, 0, 0, calculatedHeight)
					DropdownFrame.Size = UDim2.new(1, -10, 0, 45 + calculatedHeight + 5)
					MainBtn.Text = selectedDisplay .. " ▲"
				else
					Container.Size = UDim2.new(0.5, 0, 0, 0)
					DropdownFrame.Size = UDim2.new(1, -10, 0, 45)
					MainBtn.Text = selectedDisplay .. " ▼"
				end
			end

			MainBtn.MouseButton1Click:Connect(toggleDropdown)

			local function setSelected(keyOpt)
				if table.find(options, keyOpt) then
					selectedKey = keyOpt
					selectedDisplay = nameMap[keyOpt] or keyOpt
					MainBtn.Text = selectedDisplay .. " ▼"
					if callback then callback(keyOpt) end
				end
			end

			for _, keyOpt in ipairs(options) do
				local displayText = nameMap[keyOpt] or keyOpt
				local OptBtn = Instance.new("TextButton")
				OptBtn.Size = UDim2.new(1, 0, 0, 25)
				OptBtn.BackgroundColor3 = Color3.fromRGB(60, 35, 20)
				OptBtn.Text = displayText
				OptBtn.TextColor3 = Color3.fromRGB(255, 252, 245)
				OptBtn.Font = Enum.Font.SourceSans
				OptBtn.TextSize = 13
				OptBtn.Parent = Container

				OptBtn.MouseButton1Click:Connect(function()
					selectedKey = keyOpt
					selectedDisplay = displayText
					MainBtn.Text = selectedDisplay .. " ▼"
					if isOpen then toggleDropdown() end
					if callback then callback(keyOpt) end
				end)
			end

			if flagName then
				registeredFlags[flagName] = {
					type = "Dropdown",
					get = function() return selectedKey end,
					set = function(v) setSelected(v) end
				}
			end
		end

		return TabMethods
	end

	-- 내장 Settings 탭 생성 (단축키, 투명도 및 설정 콘픽 시스템 통합)
