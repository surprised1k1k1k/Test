	BindLabel.Position = UDim2.new(0, 12, 0, 0)
	BindLabel.Text = "UI 열기/닫기 단축키"
	BindLabel.TextColor3 = Color3.fromRGB(255, 252, 245)
	BindLabel.Font = Enum.Font.SourceSans
	BindLabel.TextSize = 14
	BindLabel.TextXAlignment = Enum.TextXAlignment.Left
	BindLabel.BackgroundTransparency = 1
	BindLabel.Parent = BindFrame

	local BindBtn = Instance.new("TextButton")
	BindBtn.Size = UDim2.new(0.5, 0, 0, 30)
	BindBtn.Position = UDim2.new(0.45, 0, 0.5, -15)
	BindBtn.BackgroundColor3 = Color3.fromRGB(50, 28, 16)
	BindBtn.Text = toggleKey.Name
	BindBtn.TextColor3 = Color3.fromRGB(255, 220, 180)
	BindBtn.Font = Enum.Font.SourceSansBold
	BindBtn.TextSize = 14
	BindBtn.Parent = BindFrame

	BindBtn.MouseButton1Click:Connect(function()
		isBinding = true
		BindBtn.Text = "키 입력 대기..."
	end)

	userInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if isBinding then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				toggleKey = input.KeyCode
				isBinding = false
				BindBtn.Text = toggleKey.Name
			end
		else
			if input.KeyCode == toggleKey then
				MainFrame.Visible = not MainFrame.Visible
			end
		end
	end)

	-- 3. 콘픽(설정) 매니저 시스템 추가
	local ConfigFolderName = "CustomHubConfigs"
	if writefile and not isfolder(ConfigFolderName) then
		makefolder(ConfigFolderName)
	end

	local function getConfigsList()
		local list = {}
		if listfiles and isfolder(ConfigFolderName) then
			for _, file in ipairs(listfiles(ConfigFolderName)) do
				local name = file:match("([^/]+)$")
				if name and name:sub(-5) == ".json" then
					table.insert(list, name:sub(1, -6))
				end
			end
		end
		if #list == 0 then table.insert(list, "default") end
		return list
	end

	-- 콘픽 이름 입력 텍스트박스
	SettingsTab:CreateTextBox("콘픽 이름", "이름 입력...", "ConfigNameBox", function(val) end)

	-- 콘픽 선택 드롭다운 생성
	local currentConfigs = getConfigsList()
	SettingsTab:CreateDropdown("콘픽 선택", currentConfigs, currentConfigs[1], {}, "SelectedConfigDropdown", function(val) end)

	-- 버튼들 (추가/저장, 불러오기, 덮어씌우기, 삭제)
	SettingsTab:CreateButton("새로 저장 (추가)", function()
		if not writefile then return warn("익스큐터가 file 기능을 지원하지 않습니다.") end
		local nameBox = registeredFlags["ConfigNameBox"]
		local configName = nameBox and nameBox.get() or ""
		if configName == "" then configName = "config_" .. math.random(1000, 9999) end

		local saveData = {}
		for flag, data in pairs(registeredFlags) do
			if flag ~= "ConfigNameBox" and flag ~= "SelectedConfigDropdown" then
				saveData[flag] = data.get()
			end
		end

		writefile(ConfigFolderName .. "/" .. configName .. ".json", httpService:JSONEncode(saveData))
		-- 드롭다운 갱신 필요시 안내
		print("콘픽 저장 완료: " .. configName)
	end)

	SettingsTab:CreateButton("선택한 콘픽 불러오기", function()
		if not readfile then return warn("익스큐터가 file 기능을 지원하지 않습니다.") end
		local drop = registeredFlags["SelectedConfigDropdown"]
		local configName = drop and drop.get() or "default"
		local filePath = ConfigFolderName .. "/" .. configName .. ".json"

		if isfile and isfile(filePath) then
			local success, decoded = pcall(function()
				return httpService:JSONDecode(readfile(filePath))
			end)
			if success and type(decoded) == "table" then
				for flag, val in pairs(decoded) do
					if registeredFlags[flag] and registeredFlags[flag].set then
						registeredFlags[flag].set(val)
					end
				end
				print("콘픽 불러오기 성공: " .. configName)
			end
		else
			warn("해당 콘픽 파일이 존재하지 않습니다: " .. configName)
		end
	end)

	SettingsTab:CreateButton("선택한 콘픽 덮어씌우기", function()
		if not writefile then return warn("익스큐터가 file 기능을 지원하지 않습니다.") end
		local drop = registeredFlags["SelectedConfigDropdown"]
		local configName = drop and drop.get() or "default"
		local filePath = ConfigFolderName .. "/" .. configName .. ".json"

		local saveData = {}
		for flag, data in pairs(registeredFlags) do
			if flag ~= "ConfigNameBox" and flag ~= "SelectedConfigDropdown" then
				saveData[flag] = data.get()
			end
		end

		writefile(filePath, httpService:JSONEncode(saveData))
		print("콘픽 덮어쓰기 완료: " .. configName)
	end)

	SettingsTab:CreateButton("선택한 콘픽 삭제", function()
		if not delfile then return warn("익스큐터가 file 기능을 지원하지 않습니다.") end
		local drop = registeredFlags["SelectedConfigDropdown"]
		local configName = drop and drop.get() or "default"
		if configName == "default" then return warn("default 콘픽은 삭제할 수 없습니다.") end
		local filePath = ConfigFolderName .. "/" .. configName .. ".json"

		if isfile and isfile(filePath) then
			delfile(filePath)
			print("콘픽 삭제 완료: " .. configName)
		end
	end)

	return WindowMethods
end

return Library
