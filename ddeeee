		function TabMethods:CreateSlider(text, min, max, default, flagName, callback)
			local Frame = Instance.new("Frame")
			Frame.Size = UDim2.new(1, -10, 0, 50)
			Frame.BackgroundColor3 = Color3.fromRGB(85, 50, 32)
			Frame.Parent = ScrollFrame

			local step = (max <= 1 or (max - min) <= 1) and 0.05 or 1
			local range = max - min
			local currentValue = default
			local initPct = math.clamp((default - min) / (range == 0 and 1 or range), 0, 1)

			local function formatVal(v)
				if step < 1 then
					return string.format("%.2f", v)
				else
					return tostring(math.floor(v + 0.5))
				end
			end

			local Label = Instance.new("TextLabel")
			Label.Size = UDim2.new(0.4, 0, 1, 0)
			Label.Position = UDim2.new(0, 12, 0, 0)
			Label.Text = text .. " (" .. formatVal(default) .. ")"
			Label.TextColor3 = Color3.fromRGB(255, 252, 245)
			Label.Font = Enum.Font.SourceSans
			Label.TextSize = 14
			Label.TextXAlignment = Enum.TextXAlignment.Left
			Label.BackgroundTransparency = 1
			Label.Parent = Frame

			local SliderTrack = Instance.new("Frame")
			SliderTrack.Size = UDim2.new(0.5, 0, 0, 6)
			SliderTrack.Position = UDim2.new(0.45, 0, 0.5, -3)
			SliderTrack.BackgroundColor3 = Color3.fromRGB(60, 35, 20)
			SliderTrack.BorderSizePixel = 0
			SliderTrack.Parent = Frame

			local SliderButton = Instance.new("TextButton")
			SliderButton.Size = UDim2.new(0, 16, 0, 20)
			SliderButton.Position = UDim2.new(initPct, -8, 0.5, -10)
			SliderButton.BackgroundColor3 = Color3.fromRGB(255, 166, 114)
			SliderButton.Text = ""
			SliderButton.Parent = SliderTrack

			local function setValue(val)
				val = math.clamp(val, min, max)
				currentValue = val
				local snappedPct = (val - min) / (range == 0 and 1 or range)
				SliderButton.Position = UDim2.new(snappedPct, -8, 0.5, -10)
				Label.Text = text .. " (" .. formatVal(val) .. ")"
				if callback then callback(val) end
			end

			local dragging = false
			SliderButton.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true end
			end)
			userInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
			end)
			userInputService.InputChanged:Connect(function(input)
				if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					local rawPct = math.clamp((input.Position.X - SliderTrack.AbsolutePosition.X) / SliderTrack.AbsoluteSize.X, 0, 1)
					local rawVal = min + (rawPct * range)
					local steppedVal = math.floor((rawVal / step) + 0.5) * step
					setValue(steppedVal)
				end
			end)

			if flagName then
				registeredFlags[flagName] = {
					type = "Slider",
					get = function() return currentValue end,
					set = function(v) setValue(v) end
				}
			end
		end

